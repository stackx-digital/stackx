# =============================================================================
# STACKx Ad Intelligence — PRODUCTION environment (Laravel Cloud)
# Reference only. Set these as environment variables in the Laravel Cloud
# dashboard (Settings → Environment). NEVER commit real secrets.
# Do NOT wrap values in < > angle brackets — paste the raw value or leave blank.
# =============================================================================

APP_NAME="STACKx Ad Intelligence"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # generate: `php artisan key:generate --show`
APP_URL=https://app.stackxdigital.my   # your real https domain, no < >

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database: Postgres (needs pgvector for P3) -----------------------------
# Option A — Laravel Cloud Postgres: provision it in the dashboard and Laravel
#   Cloud injects the DB_* vars for you (pgvector is available). Simplest.
# Option B — Supabase: use the SESSION pooler (port 5432), NOT the transaction
#   pooler (6543) which breaks prepared statements. Host/password from the
#   Supabase dashboard → Project Settings → Database. If auth fails, reset the
#   database password there and paste the new one.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.cmjicnhdwxavzhiavvfz
DB_PASSWORD=

# --- Sessions / cache / queue ----------------------------------------------
# All DB-backed → safe across multiple app containers + the worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # HTTPS only
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail: needed for email VERIFICATION + password reset (not login) -------
# Login is email + password, so mail is NOT required to sign in. It IS needed
# to send the verification link and password-reset emails. Two options:
#   1. Configure a real mailer (Resend/Postmark/SES/Mailgun) below, OR
#   2. Skip mail for now (MAIL_MAILER=log) and bootstrap a pre-verified account
#      from the Commands tab:  php artisan stackx:account you@company.com
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=                 # provider API key / SMTP password
MAIL_FROM_ADDRESS="no-reply@stackxdigital.my"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI layer (OPTIONAL deployment-wide fallback) --------------------------
# SaaS: each tenant enters their own keys at /settings (encrypted). These env
# keys are only a fallback used when a tenant hasn't set their own — leave
# blank to require every tenant to bring their own.
AI_PROVIDER=anthropic
AI_TIMEOUT=60
AI_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# --- Embeddings (P3 Ad Discovery) — optional fallback ----------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
VOYAGE_API_KEY=

# --- Meta Marketing API (P1 live sync) — optional per-tenant at /settings ---
# Pull your OWN ad-account creative performance (ad-level, daily). Tenants enter
# their System User token + ad account id at /settings; these env values are a
# deployment-wide fallback. Runs daily (meta:sync) or on-demand from the app.
META_SYSTEM_TOKEN=
META_AD_ACCOUNT_ID=          # act_123456789 (with or without the act_ prefix)
META_GRAPH_VERSION=v21.0
META_LOOKBACK_DAYS=30

# --- Meta Ad Library (P2 Brand Spy) — optional per-tenant at /settings ------
FEATURE_META_AD_LIBRARY=false
META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_COUNTRY=MY

# --- Slack (P5 report summary) — optional per-tenant at /settings -----------
SLACK_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
