# =============================================================================
# STACKx Ad Intelligence — PRODUCTION environment (Laravel Cloud)
# Reference only. Set these as environment variables in the Laravel Cloud
# dashboard (Settings → Environment). NEVER commit real secrets.
# =============================================================================

APP_NAME="STACKx Ad Intelligence"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # generate: `php artisan key:generate --show`
APP_URL=https://intel.stackx.my

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database: Supabase Postgres -------------------------------------------
# IMPORTANT: use the SESSION pooler (port 5432) for a persistent Laravel app,
# NOT the transaction pooler (6543) — the latter breaks prepared statements.
# Host/password: Supabase dashboard → Project Settings → Database.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.cmjicnhdwxavzhiavvfz
DB_PASSWORD=

# --- Sessions / cache / queue ----------------------------------------------
# All DB-backed → safe across multiple app containers + the worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # HTTPS only
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail: REQUIRED for magic-link login -----------------------------------
# Without working mail, nobody can sign in. Use Resend/Postmark/SES/etc.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=                 # provider API key / SMTP password
MAIL_FROM_ADDRESS="no-reply@stackx.my"
MAIL_FROM_NAME="${APP_NAME}"

# --- Team access allowlist (required) --------------------------------------
STACKX_ALLOWED_EMAILS="@stackx.my"
STACKX_MAGIC_LINK_TTL=15

# --- AI layer (provider-agnostic) ------------------------------------------
AI_PROVIDER=anthropic
AI_TIMEOUT=60
AI_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# --- Meta (P1 sync flagged off; P2 Ad Library) -----------------------------
FEATURE_META_API_SYNC=false
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_AD_LIBRARY_TOKEN=

# --- Supabase (Storage + pgvector via dashboard/SDK) -----------------------
SUPABASE_URL=https://cmjicnhdwxavzhiavvfz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Slack (P5) ------------------------------------------------------------
SLACK_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
