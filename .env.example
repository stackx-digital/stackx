APP_NAME="STACKx Ad Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Database — Supabase Postgres (Postgres + pgvector + Storage host)
# Get host/password from Supabase dashboard → Project Settings → Database.
# Use the connection pooler host for app traffic. pgvector is enabled in M2.
# For zero-setup local dev you can switch DB_CONNECTION=sqlite instead.
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.cmjicnhdwxavzhiavvfz
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# =============================================================================
# Mail — magic-link sign-in emails. In local dev "log" writes the link to
# storage/logs/laravel.log so you can sign in without SMTP.
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@stackx.my"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# STACKx team access allowlist (required)
# Comma-separated. Full email (alice@stackx.my) or domain glob (@stackx.my).
# Empty = nobody gets in (fails closed).
# =============================================================================
STACKX_ALLOWED_EMAILS="@stackx.my"
STACKX_MAGIC_LINK_TTL=15

# =============================================================================
# AI layer — provider-agnostic (driver pattern). Swap with AI_PROVIDER.
# Both drivers ship; default is Anthropic. No code change to switch.
# =============================================================================
AI_PROVIDER=anthropic
AI_TIMEOUT=60
AI_RETRIES=2

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# =============================================================================
# Meta Marketing API (P1 sync, behind a flag). CSV import (Ads Manager export)
# is the MVP ingest path; API sync is gated until app review / advanced access.
# =============================================================================
FEATURE_META_API_SYNC=false
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=

# Meta Ad Library (P2 Brand Spy)
META_AD_LIBRARY_TOKEN=

# =============================================================================
# Supabase (for Storage + pgvector via the dashboard/SDK; DB is configured
# above via the pgsql connection). Service role key is server-only.
# =============================================================================
SUPABASE_URL=https://cmjicnhdwxavzhiavvfz.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Slack (P5 scheduled report summary)
SLACK_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
