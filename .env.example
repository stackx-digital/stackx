# =============================================================================
# STACKx Ad Intelligence — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Only the Supabase + allowlist + app vars are required to run M1.
# =============================================================================

# --- Supabase (required for M1) -------------------------------------------
# Project: stackx-ad-intelligence (org: Stack Digital, region: ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Get from Supabase dashboard → Project Settings → API.
# Used by server-side ingest/sync (M2+). Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth allowlist (required for M1) -------------------------------------
# Comma-separated. Entries may be a full email (alice@stackx.my) or a domain
# glob (@stackx.my). Empty = no one gets in (fails closed).
STACKX_ALLOWED_EMAILS=@stackx.my

# --- App (required for M1) -------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Anthropic / Claude (AI layer, wired in M5) ---------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# --- Meta Marketing API (P1 sync, behind a flag) --------------------------
# CSV import (Ads Manager export) is the MVP ingest path. The API sync is
# gated until app review / advanced access is granted.
FEATURE_META_API_SYNC=false
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=

# --- Meta Ad Library (P2 Brand Spy) ---------------------------------------
META_AD_LIBRARY_TOKEN=

# --- Slack (P5 scheduled report summary) ----------------------------------
SLACK_WEBHOOK_URL=
